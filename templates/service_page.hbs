{{!--
  Service request (item) page
  - Branded header bar with greeting + step indicator
  - Request form panel with custom submit button
  - Suggested articles sidebar (live search)
  - Helper information cards
  - Responsive: single-column, centered header on small screens
  FLICKER FIX 7-10-26:
    • Reveal the page only AFTER the embedded catalog form has finished
      rendering (settle-on-quiet), instead of on its first child — this stops
      the "empty form -> misplaced User box -> settled" staged flicker.
    • Removed the exit-overlay + click interceptor (cosmetic, fragile, and a
      cause of blank-page navigations). Links now navigate natively.
  GREETING FIX 7-13-26:
    • The greeting no longer renders "How can we help?" and then swaps to the
      personalized version — that two-stage change caused a visible flicker.
      It now stays hidden until the name resolves (or a failsafe fires), sets
      the final text once, then fades in a single time.
--}}
<div class="container-divider"></div>
<div class="container svc-container">
  <div class="sub-nav svc-subnav">
    {{breadcrumbs}}
  </div>
  <div id="main-content">
    <div class="svc-shell">

      {{!-- Compact search (services + resources) --}}
      <div class="svc-searchrow">
        <form class="svc-mini-search" id="svc-mini-search" role="search" autocomplete="off">
          <i class="svc-mini-search-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </i>
          <input type="text" id="svc-mini-input" class="svc-mini-input"
                 placeholder="Search services and resources…" aria-label="Search"
                 role="combobox" aria-expanded="false" aria-controls="svc-mini-results" aria-autocomplete="list" />
          <button type="submit" class="svc-mini-search-btn" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <div class="svc-mini-results" id="svc-mini-results" role="listbox" aria-label="Search results" hidden></div>
        </form>
      </div>

      {{!-- Header bar: logo (desktop), centered greeting, step indicator --}}
      <div class="svc-topbar">
        <div class="svc-topbar-inner">
          <div class="svc-topbar-left">
            <a class="svc-topbar-logo" href="https://arpah1775164538.zendesk.com/hc/en-us/services" aria-label="Go to Service Catalog home">
              {{asset "HLOGO.png"}}
            </a>
            <div class="svc-topbar-text">
              <h1 class="svc-title" id="svc-greeting">How can we help?</h1>
            </div>
          </div>
          <ol class="svc-steps" aria-label="How this request works">
            <li class="svc-step svc-step-active">
              <span class="svc-step-number">1</span>
              <span class="svc-step-label">Describe your request below</span>
            </li>
            <li class="svc-step svc-step-active">
              <span class="svc-step-number">2</span>
              <span class="svc-step-label">Submit to the Service Desk</span>
            </li>
          </ol>
        </div>
      </div>

      {{!-- Main content: form (left) + suggested articles (right) --}}
      <div class="svc-form-layout">
        <div class="svc-form-column">
          <div class="svc-form-panel" aria-label="Service request form">
            <div id="service-catalog-item"></div>
            <!-- Skeleton placeholder: shows instantly while Zendesk's form
                 renders, then fades out once the real form is present. Purely
                 cosmetic — if anything fails, the real form still shows. -->
            <div id="svc-form-skeleton" class="svc-skeleton" aria-hidden="true">
              <div class="svc-skel-row svc-skel-icon-row">
                <div class="svc-skel-avatar"></div>
                <div class="svc-skel-lines">
                  <div class="svc-skel-bar svc-skel-title"></div>
                  <div class="svc-skel-bar svc-skel-sub"></div>
                </div>
              </div>
              <div class="svc-skel-divider"></div>
              <div class="svc-skel-bar svc-skel-label"></div>
              <div class="svc-skel-bar svc-skel-input"></div>
              <div class="svc-skel-bar svc-skel-label svc-skel-label-2"></div>
              <div class="svc-skel-box"></div>
            </div>
            <div class="svc-custom-submit-wrap">
              <button type="button" id="svc-custom-submit" class="svc-custom-submit-btn">Submit request</button>
              <p class="svc-custom-submit-note">Review your request details, then submit to the Service Desk.</p>
            </div>
          </div>
        </div>
        <aside class="svc-side-column" aria-label="Suggested help articles">
          <section class="svc-article-card">
            <div class="svc-article-card-header">
              <h2 class="svc-card-title svc-article-title">Suggested articles</h2>
              <p class="svc-article-subtitle">Related content appears as you type.</p>
            </div>
            <div id="svc-suggested-articles" class="svc-article-list" aria-live="polite">
              <div class="svc-article-empty">Start typing in the request form to see related knowledge base articles.</div>
            </div>
          </section>
        </aside>
      </div>

      {{!-- Helper information cards --}}
      <div class="svc-helper-row" aria-label="Helpful information">
        <section class="svc-card">
          <h2 class="svc-card-title">Helpful details to include</h2>
          <ul class="svc-card-list">
            <li>What you're trying to do or fix in plain language.</li>
            <li>Where this applies (system, URL, device, location, or team).</li>
            <li>Who is affected (you, your team, or a distribution list).</li>
            <li>Any timing or context that might change how we handle it.</li>
          </ul>
        </section>
        <section class="svc-card">
          <h2 class="svc-card-title">What happens after you submit?</h2>
          <ul class="svc-card-list">
            <li>You'll receive an email confirmation with your request or ticket number.</li>
            <li>You can reply to that email at any time to add updates or attachments.</li>
            <li>You can track progress in the Service Hub under <strong>My requests</strong>.</li>
          </ul>
        </section>
        <section class="svc-card">
          <h2 class="svc-card-title">Need help with the form?</h2>
          <ul class="svc-card-list">
            <li>If you're not sure which option fits, pick the closest one and explain in the description field.</li>
            <li>Use clear language instead of acronyms whenever possible.</li>
            <li>For urgent issues, keep using your usual escalation channel in addition to submitting this request.</li>
          </ul>
        </section>
      </div>

      {{!-- General-request footer banner --}}
      <div class="svc-help-banner">
        <div class="svc-help-banner-text">
          <span class="svc-help-banner-title">Still can&rsquo;t find what you need?</span>
          <span class="svc-help-banner-sub">Submit a general request.</span>
        </div>
        <a class="svc-help-btn" href="https://arpah1775164538.zendesk.com/hc/en-us/services/01KT6W4J21065JGC51VMSW8AGB?category_id=01KP3TEETSJKEPJ08CSK7MJG41">
          General request
        </a>
      </div>

    </div>
  </div>
</div>

<style>
/* ============================================================
   BASE LAYOUT
   ============================================================ */
body { background: #ffffff; }
.container-divider { border-top: none; height: 16px; background: transparent; }
.svc-container { max-width: 1280px; }
.svc-subnav { margin-bottom: 10px; }
.svc-shell {
  background: #ffffff;
  border-radius: 20px;
  box-shadow: 0 14px 36px rgba(15, 33, 80, 0.08), 0 0 0 1px rgba(16, 30, 67, 0.05);
  padding: 20px 22px 24px;
  margin-bottom: 36px;
}

/* ============================================================
   HEADER BAR (greeting + step indicator)
   ============================================================ */
.svc-topbar {
  background: #eef2fb;
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 18px;
  color: #111827;
  box-shadow: 0 8px 20px rgba(15, 33, 80, 0.05), 0 0 0 1px rgba(17, 24, 39, 0.05);
}
.svc-topbar-inner { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
.svc-topbar-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
.svc-topbar-logo {
  height: 44px; width: 44px; min-width: 44px;
  display: flex; align-items: center; justify-content: center;
  text-decoration: none; border-radius: 12px; overflow: hidden; background: transparent;
}
.svc-topbar-logo img, .svc-topbar-logo svg { width: 44px; height: 44px; object-fit: contain; display: block; }

/* Greeting centered within the header bar */
.svc-topbar-text {
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-width: 0;
}
.svc-title {
  margin: 0;
  width: 100%;
  text-align: center;
  font-size: clamp(20px, 2.4vw, 26px);
  line-height: 1.15;
  font-weight: 700;
  color: #111827;
}

/* Step indicator pills */
.svc-steps { list-style: none; margin: 0; padding: 0; display: flex; gap: 8px; }
.svc-step {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 12px; border-radius: 999px;
  background: #ffffff; font-size: 11px; color: #6b7280;
  border: 1px solid rgba(15, 33, 80, 0.08);
}
.svc-step-number {
  height: 18px; width: 18px; border-radius: 999px;
  background: #e5e9f2; color: #6b7280;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 600;
}
.svc-step-active { background: #ffffff; color: #003399; border-color: #b9c9ef; box-shadow: 0 2px 6px rgba(0, 51, 153, 0.12); }
.svc-step-active .svc-step-number { background: #003399; color: #ffffff; }
/* Keep each step label on a single line */
.svc-step-label { font-weight: 500; white-space: nowrap; }

/* ============================================================
   CONTENT LAYOUT (form + sidebar)
   ============================================================ */
.svc-form-layout {
  display: grid;
  grid-template-columns: minmax(0, 3fr) minmax(250px, 0.9fr);
  gap: 20px; align-items: start;
}
.svc-form-column, .svc-side-column { min-width: 0; }
.svc-form-panel {
  background: #ffffff; border-radius: 16px; padding: 16px 12px 16px;
  box-shadow: 0 8px 24px rgba(15, 33, 80, 0.06), 0 0 0 1px rgba(17, 24, 39, 0.04);
  overflow: visible;
  /* Reserve stable height so the page doesn't start short (skeleton) and then
     jump taller when the real form renders — that reflow was causing bottom
     helper-card text to briefly ghost up near the header during load. */
  min-height: 520px;
  position: relative;
}
/* Once the real form is in, the min-height is no longer needed (form sets
   its own height); relax it so short forms don't leave dead space. */
.svc-form-ready .svc-form-panel { min-height: 0; }

/* ============================================================
   SUGGESTED ARTICLES SIDEBAR
   ============================================================ */
.svc-article-card {
  position: sticky; top: 24px; border-radius: 16px; background: #f7f9ff;
  box-shadow: 0 8px 24px rgba(15, 33, 80, 0.06), 0 0 0 1px rgba(17, 24, 39, 0.04);
  padding: 16px;
}
.svc-article-card-header { margin-bottom: 12px; }
.svc-article-title { margin-bottom: 4px; }
/* Subtitle kept to a single line, with an ellipsis fallback if needed */
.svc-article-subtitle {
  margin: 0;
  font-size: 12px;
  line-height: 1.5;
  color: #6b7280;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.svc-article-list { display: flex; flex-direction: column; gap: 10px; }
.svc-article-empty, .svc-article-loading, .svc-article-error {
  font-size: 13px; line-height: 1.5; color: #6b7280; background: #ffffff;
  border: 1px dashed #d6dbe7; border-radius: 12px; padding: 12px;
}
.svc-article-error { color: #7c2d12; background: #fff7ed; border-color: #fed7aa; }
.svc-article-item {
  display: block; text-decoration: none; color: #0f172a; background: #ffffff;
  border: 1px solid #e5e7eb; border-radius: 12px; padding: 12px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}
.svc-article-item:hover { border-color: #bfd0f3; box-shadow: 0 8px 18px rgba(15, 33, 80, 0.08); transform: translateY(-1px); }
.svc-article-item-title { display: block; font-size: 13px; font-weight: 600; color: #003399; margin-bottom: 4px; }
.svc-article-item-meta { display: block; font-size: 12px; color: #6b7280; line-height: 1.45; }

/* ============================================================
   CATALOG FORM WIDTH OVERRIDES
   The embedded catalog form renders with fixed widths; these
   rules make every field and container fill the panel width.
   ============================================================ */
.svc-form-panel #service-catalog-item,
.svc-form-panel #service-catalog-item > *,
.svc-form-panel #service-catalog-item > * > *,
.svc-form-panel #service-catalog-item > * > * > *,
.svc-form-panel form,
.svc-form-panel form > *,
.svc-form-panel form > * > *,
.svc-form-panel form > * > * > * {
  width: 100% !important; max-width: none !important; min-width: 0 !important; box-sizing: border-box !important;
}
.svc-form-panel [style*="max-width"],
.svc-form-panel [style*="width: 320"], .svc-form-panel [style*="width:320"],
.svc-form-panel [style*="width: 360"], .svc-form-panel [style*="width:360"],
.svc-form-panel [style*="width: 400"], .svc-form-panel [style*="width:400"],
.svc-form-panel [style*="width: 480"], .svc-form-panel [style*="width:480"],
.svc-form-panel [style*="width: 500"], .svc-form-panel [style*="width:500"],
.svc-form-panel [style*="width: 560"], .svc-form-panel [style*="width:560"] {
  max-width: none !important; width: 100% !important;
}
.svc-form-panel * { box-sizing: border-box; }
.svc-form-panel .form-field, .svc-form-panel .field, .svc-form-panel .request-form,
.svc-form-panel fieldset, .svc-form-panel section, .svc-form-panel article,
.svc-form-panel div, .svc-form-panel div[role="group"],
.svc-form-panel [class*="field"], .svc-form-panel [class*="Field"],
.svc-form-panel [class*="form"], .svc-form-panel [class*="Form"],
.svc-form-panel [class*="layout"], .svc-form-panel [class*="Layout"],
.svc-form-panel [class*="grid"], .svc-form-panel [class*="Grid"],
.svc-form-panel [class*="row"], .svc-form-panel [class*="Row"],
.svc-form-panel [class*="column"], .svc-form-panel [class*="Column"] {
  max-width: none !important; min-width: 0 !important;
}
/* Remove the gray background behind form field wrappers' avatars/icons */
.svc-form-panel figure,
.svc-form-panel [data-garden-id="avatars.avatar"],
.svc-form-panel [class*="StyledAvatar"],
.svc-form-panel [class*="imWYAI"],
.svc-form-panel [class*="hkLxcw"] {
  background: transparent !important; background-color: transparent !important;
  box-shadow: none !important; border: none !important;
}
/* Prevent flex containers from collapsing form fields */
.svc-form-panel [class*="dIeWIF"], .svc-form-panel .sc-jEACwC {
  flex: 1 1 100% !important; min-width: 0 !important; width: 100% !important;
}
.svc-form-panel label { display: block; width: 100%; }
.svc-form-panel input[type],
.svc-form-panel input[type="text"], .svc-form-panel input[type="email"],
.svc-form-panel input[type="search"], .svc-form-panel input[type="tel"],
.svc-form-panel input[type="url"], .svc-form-panel input[type="number"],
.svc-form-panel select, .svc-form-panel textarea {
  display: block; width: 100% !important; max-width: none !important; min-width: 0 !important; box-sizing: border-box !important;
}
.svc-form-panel textarea { resize: both !important; min-width: 100% !important; max-width: 100% !important; overflow: auto; }
.svc-form-panel select { min-height: 38px; }

/* Long service titles: wrap instead of overflowing */
.svc-form-panel #service-catalog-item h1,
.svc-form-panel #service-catalog-item h2 {
  overflow-wrap: anywhere !important;
  word-break: normal !important;
  white-space: normal !important;
  max-width: 100% !important;
  font-size: clamp(22px, 5vw, 34px) !important;
  line-height: 1.2 !important;
}

/* Service item icon: never clip (some icons rendered cut off at the top) */
.svc-form-panel #service-catalog-item figure,
.svc-form-panel #service-catalog-item [data-garden-id="avatars.avatar"],
.svc-form-panel #service-catalog-item [class*="StyledAvatar"],
.svc-form-panel #service-catalog-item [class*="Avatar"],
.svc-form-panel #service-catalog-item [class*="imWYAI"],
.svc-form-panel #service-catalog-item [class*="hkLxcw"],
.svc-form-panel #service-catalog-item [class*="icon"],
.svc-form-panel #service-catalog-item [class*="Icon"] {
  overflow: visible !important;
  height: auto !important;
  min-height: 0 !important;
  max-height: none !important;
  line-height: normal !important;
}
.svc-form-panel #service-catalog-item svg,
.svc-form-panel #service-catalog-item img {
  overflow: visible !important;
  max-width: 100% !important;
  height: auto !important;
  display: block !important;
}
.svc-form-panel #service-catalog-item > *:first-child {
  overflow: visible !important;
  padding-top: 4px !important;
}

/* ============================================================
   CUSTOM SUBMIT BUTTON
   Hides the catalog's native action area and shows our button.
   ============================================================ */
.svc-hide-native-actions { display: none !important; }
.svc-custom-submit-wrap {
  margin-top: 20px; padding-top: 18px; border-top: 1px solid #e5e7eb;
  display: flex; flex-direction: column; align-items: flex-start; gap: 10px;
}
.svc-custom-submit-btn {
  min-width: 240px; background: #003b91; color: #ffffff;
  padding: 14px 28px; border-radius: 14px; font-size: 15px; line-height: 1.2;
  font-weight: 700; letter-spacing: 0.01em; border: none; cursor: pointer; box-shadow: none;
  transition: background-color 0.18s ease, transform 0.12s ease, filter 0.18s ease;
}
.svc-custom-submit-btn:hover { background: #002a6e; transform: translateY(-1px); }
.svc-custom-submit-btn:focus { outline: none; }
.svc-custom-submit-btn:focus-visible { outline: 2px solid #6ea8ff; outline-offset: 2px; }
.svc-custom-submit-btn:active { background: #001f56; transform: scale(0.985); filter: brightness(0.97); }
.svc-custom-submit-btn:disabled { opacity: 0.7; cursor: wait; transform: none; background: #003b91; }
.svc-custom-submit-note { margin: 0; font-size: 12px; color: #6b7280; }

/* ============================================================
   HELPER INFORMATION CARDS
   ============================================================ */
.svc-helper-row { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 20px; }
.svc-card {
  flex: 1 1 0; min-width: 220px; border-radius: 16px; background: #f7f9ff !important;
  box-shadow: 0 8px 20px rgba(15, 33, 80, 0.04), 0 0 0 1px rgba(17, 24, 39, 0.04); padding: 14px 16px;
}
.svc-card-title { margin: 0 0 8px; font-size: 14px; font-weight: 600; color: #111827; }
.svc-card-list { margin: 0; padding-left: 18px; font-size: 13px; line-height: 1.55; color: #4b5563; }
.svc-card-list li + li { margin-top: 4px; }

/* ============================================================
   GENERAL-REQUEST FOOTER BANNER
   ============================================================ */
.svc-help-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
  width: 100%;
  margin: 20px 0 0;
  padding: 18px 22px;
  box-sizing: border-box;
  border: 1px solid #e3e8f0;
  border-radius: 16px;
  background: #f7f9ff;
}
.svc-help-banner-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.svc-help-banner-title { font-size: 15px; font-weight: 600; color: #1d2b4d; }
.svc-help-banner-sub { font-size: 13px; color: #5b6472; }
.svc-help-btn {
  display: inline-flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  padding: 10px 20px;
  border-radius: 999px;
  font-size: 13.5px; font-weight: 600;
  text-align: center;
  color: #003399 !important;
  text-decoration: none !important;
  background: #ffffff;
  border: 1.5px solid #003399;
  transition: background-color 0.16s ease, color 0.16s ease;
}
.svc-help-btn:hover { background: #003399; color: #ffffff !important; }

/* ============================================================
   FLOATING TRAINING BUTTON (bottom-right)
   ============================================================ */
.svc-training-fab {
  position: fixed; right: 24px; bottom: 24px; z-index: 9000;
  display: inline-flex; align-items: center; gap: 0;
  height: 52px; width: 52px; max-width: 52px; padding: 0; border-radius: 999px;
  background: linear-gradient(145deg, #c4006a, #e6007e);
  color: #ffffff !important; text-decoration: none !important;
  overflow: hidden; white-space: nowrap; box-shadow: 0 8px 20px rgba(230, 0, 126, 0.32);
  transition: max-width 0.34s cubic-bezier(0.22, 1, 0.36, 1), width 0.34s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.24s ease, transform 0.24s ease;
}
.svc-training-fab-icon { flex: 0 0 52px; width: 52px; height: 52px; display: inline-flex; align-items: center; justify-content: center; }
.svc-training-fab-icon svg { width: 22px; height: 22px; stroke: #ffffff; }
.svc-training-fab-label {
  flex: 1 1 auto; padding-right: 20px; font-size: 14px; font-weight: 600; line-height: 1;
  opacity: 0; transform: translateX(-4px);
  transition: opacity 0.2s ease 0.06s, transform 0.24s ease 0.06s;
}
.svc-training-fab:hover, .svc-training-fab:focus-visible {
  width: auto; max-width: 320px; transform: translateY(-2px); box-shadow: 0 12px 26px rgba(230, 0, 126, 0.40);
}
.svc-training-fab:hover .svc-training-fab-label, .svc-training-fab:focus-visible .svc-training-fab-label { opacity: 1; transform: translateX(0); }
.svc-training-fab.svc-fab-pulse { animation: svcFabPulse 1.6s ease-in-out 1; }
@keyframes svcFabPulse {
  0%   { box-shadow: 0 8px 20px rgba(230, 0, 126, 0.32), 0 0 0 0 rgba(230, 0, 126, 0.40); }
  60%  { box-shadow: 0 8px 20px rgba(230, 0, 126, 0.32), 0 0 0 14px rgba(230, 0, 126, 0); }
  100% { box-shadow: 0 8px 20px rgba(230, 0, 126, 0.32), 0 0 0 0 rgba(230, 0, 126, 0); }
}

/* ============================================================
   PAGE LOAD (skeleton placeholder, no page-level masking)
   ------------------------------------------------------------
   The shell (topbar, cards, sidebar) renders instantly. Only the form
   panel shows a soft skeleton while Zendesk's form renders, then the real
   form fades in over it. Cosmetic only — if the swap logic fails, the real
   form still displays (the skeleton just fades on a timeout failsafe).
   ============================================================ */

/* Real form starts invisible so we don't see it assemble; fades in when
   the swap script adds .svc-form-ready. Failsafe CSS reveal after 6.5s in
   case JS never runs, so the form can't stay hidden. (Kept just beyond the
   JS 6s hard cap so the script normally wins and there's no double-swap.) */
#service-catalog-item { opacity: 0; transition: opacity 0.3s ease; }
.svc-form-ready #service-catalog-item { opacity: 1; }
@keyframes svcFormFailsafe { to { opacity: 1; } }
#service-catalog-item { animation: svcFormFailsafe 0s linear 6.5s forwards; }

/* The custom submit block is meaningless until the form exists, and while
   the skeleton is absolutely positioned the empty form collapses, letting
   this block float up over the skeleton. Hide it until the form is ready. */
.svc-custom-submit-wrap { opacity: 0; transition: opacity 0.3s ease; }
.svc-form-ready .svc-custom-submit-wrap { opacity: 1; }
.svc-custom-submit-wrap { animation: svcFormFailsafe 0s linear 6.5s forwards; }

/* ------------------------------------------------------------
   GREETING SMOOTH LOAD
   The greeting starts hidden and is revealed once — after the
   personalized name resolves (or a failsafe fires) — so the user
   never sees "How can we help?" swap to "How can we help, Name?".
   The CSS animation is a backstop in case JS never runs; the JS
   normally reveals well before 2.5s.
   ------------------------------------------------------------ */
#svc-greeting { opacity: 0; transition: opacity 0.25s ease; }
#svc-greeting.svc-greeting-ready { opacity: 1; }
#svc-greeting { animation: svcFormFailsafe 0s linear 2.5s forwards; }

/* Skeleton placeholder — absolutely positioned inside the panel so that the
   real form rendering underneath it doesn't change the panel's flow height
   (which caused bottom content to ghost near the header during load). */
.svc-skeleton {
  position: absolute;
  top: 16px; left: 12px; right: 12px;
  transition: opacity 0.3s ease;
  z-index: 1;
}
.svc-skeleton.svc-skel-hide { opacity: 0; pointer-events: none; }
.svc-skel-row { display: flex; align-items: center; gap: 14px; }
.svc-skel-icon-row { margin-bottom: 6px; }
.svc-skel-avatar { width: 52px; height: 52px; border-radius: 12px; flex: 0 0 52px; }
.svc-skel-lines { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.svc-skel-bar { height: 14px; border-radius: 8px; }
.svc-skel-title { width: 60%; height: 22px; }
.svc-skel-sub { width: 85%; }
.svc-skel-divider { height: 1px; background: #eef1f6; margin: 18px 0; }
.svc-skel-label { width: 30%; height: 12px; margin-bottom: 10px; }
.svc-skel-label-2 { margin-top: 22px; }
.svc-skel-input { width: 100%; height: 40px; border-radius: 10px; }
.svc-skel-box { width: 100%; height: 120px; border-radius: 10px; }

/* Shimmer sweep on all skeleton pieces */
.svc-skel-avatar, .svc-skel-bar, .svc-skel-input, .svc-skel-box {
  background: linear-gradient(100deg, #eef1f6 30%, #f6f8fc 50%, #eef1f6 70%);
  background-size: 200% 100%;
  animation: svcSkelShimmer 1.3s ease-in-out infinite;
}
@keyframes svcSkelShimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}

/* Hide any template editor debris */
body > pre, body > code, body > .template-name, body > .editor-label { display: none !important; }

/* ============================================================
   COMPACT SEARCH ROW (services + resources)
   ============================================================ */
.svc-searchrow { margin: 0 0 16px; }
.svc-mini-search {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  max-width: 560px;
  margin: 0 auto;
  padding: 4px 4px 4px 14px;
  background: #ffffff;
