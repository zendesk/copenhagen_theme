/* ============================================================
   RESPONSIVE — PHONES
   ============================================================ */
@media (max-width: 600px) {
  .svc-form-panel #service-catalog-item h1,
  .svc-form-panel #service-catalog-item h2 {
    font-size: clamp(20px, 6vw, 26px) !important;
  }
  /* Keep the submit note on one line */
  .svc-custom-submit-note {
