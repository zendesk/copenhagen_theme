}
.svc-mr-group-header.svc-mr-docs { border-top: 0.5px solid #eef1f6; background: #fcfcfd; }
.svc-mr-group-title { font-size: 11px; font-weight: 600; letter-spacing: 0.6px; text-transform: uppercase; }
.svc-mr-services .svc-mr-group-title { color: #003399; }
.svc-mr-docs .svc-mr-group-title { color: #003399; }
.svc-mr-group-count { font-size: 11px; color: #9aa1ad; }
.svc-mr-item {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 16px;
  text-decoration: none; cursor: pointer;
  transition: background-color 0.14s ease;
}
.svc-mr-item:hover, .svc-mr-item.svc-mr-active { background: #f5f8ff; }
.svc-mr-item.svc-mr-service { border-left: 3px solid #003399; }
.svc-mr-item.svc-mr-doc { border-left: 3px solid #c9ced8; }
.svc-mr-icon {
  width: 32px; height: 32px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: 9px;
}
.svc-mr-service .svc-mr-icon { background: #eaf0ff; color: #003399; }
.svc-mr-doc .svc-mr-icon { background: #f1f3f7; color: #6b7280; }
.svc-mr-icon svg { width: 17px; height: 17px; }
.svc-mr-text { flex: 1; min-width: 0; }
.svc-mr-title, .svc-mr-sub {
  display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.svc-mr-title { font-size: 13.5px; color: #1d2b4d; text-decoration: none; }
.svc-mr-sub { font-size: 12px; color: #8089a0; }
.svc-mr-badge { flex-shrink: 0; font-size: 10.5px; font-weight: 600; padding: 3px 9px; border-radius: 999px; }
.svc-mr-service .svc-mr-badge { color: #003399; background: #eaf0ff; }
.svc-mr-doc .svc-mr-badge { color: #6b7280; background: #eef1f6; }
.svc-mr-empty, .svc-mr-loading { padding: 16px; font-size: 13px; color: #8089a0; text-align: center; }
.svc-mr-footer {
  display: block; padding: 11px 16px;
  border-top: 0.5px solid #eef1f6;
  font-size: 12.5px; font-weight: 500; color: #003399;
  text-align: center; text-decoration: none;
}
.svc-mr-footer:hover { background: #f5f8ff; }

/* ============================================================
   RESPONSIVE — TABLET AND BELOW
   ============================================================ */
@media (max-width: 960px) {
  .svc-shell { padding: 16px 12px 20px; }
  .svc-form-layout { grid-template-columns: 1fr; }
  .svc-side-column { order: 2; }
