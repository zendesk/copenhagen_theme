.svc-mini-search-btn svg { width: 16px; height: 16px; }
.svc-mini-search-btn:hover { background: #002a6e; }

/* Live results dropdown (fixed so it aligns at any width) */
.svc-mini-results {
  position: fixed;
  z-index: 99999;
  max-height: 70vh;
  overflow-x: hidden;
  overflow-y: auto;
