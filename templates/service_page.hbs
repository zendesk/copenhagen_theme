{{!--
  Service request (item) page
  STYLES: moved to style.css (ARPA-H custom — service item page section).
  Do not re-add a <style> block here; edit style.css instead.
--}}
<div class="container-divider"></div>
<div class="container svc-container">
  <div class="sub-nav svc-subnav">
    {{breadcrumbs}}
  </div>
  <div id="main-content">
    <div class="svc-shell">

      {{!-- Compact search (services + resources) --}}
      <div class="svc-searchrow">
        <form class="svc-mini-search" id="svc-mini-search" role="search" autocomplete="off">
          <i class="svc-mini-search-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </i>
          <input type="text" id="svc-mini-input" class="svc-mini-input"
                 placeholder="Search services and resources…" aria-label="{{t 'search'}}"
                 role="combobox" aria-expanded="false" aria-controls="svc-mini-results" aria-autocomplete="list" />
          <button type="submit" class="svc-mini-search-btn" aria-label="{{t 'search'}}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <div class="svc-mini-results" id="svc-mini-results" role="listbox" aria-label="Search results" hidden></div>
        </form>
      </div>

      {{!-- Header bar: logo (desktop), centered greeting, step indicator --}}
      <div class="svc-topbar">
        <div class="svc-topbar-inner">
          <div class="svc-topbar-left">
            <a class="svc-topbar-logo" href="/hc/{{help_center.base_locale}}/services" aria-label="Go to Service Catalog home">
              <img src="{{asset 'HLOGO.png'}}" alt="" />
            </a>
            <div class="svc-topbar-text">
              <h1 class="svc-title" id="svc-greeting">How can we help?</h1>
            </div>
          </div>
          <ol class="svc-steps" aria-label="How this request works">
            <li class="svc-step svc-step-active">
              <span class="svc-step-number">1</span>
              <span class="svc-step-label">Describe your request below</span>
            </li>
            <li class="svc-step svc-step-active">
              <span class="svc-step-number">2</span>
              <span class="svc-step-label">Submit to the Service Desk</span>
            </li>
          </ol>
        </div>
      </div>

      {{!-- Main content: form (left) + suggested articles (right) --}}
      <div class="svc-form-layout">
        <div class="svc-form-column">
          <div class="svc-form-panel" aria-label="Service request form">
            <div id="service-catalog-item"></div>
            <div id="svc-form-skeleton" class="svc-skeleton" aria-hidden="true">
              <div class="svc-skel-row svc-skel-icon-row">
                <div class="svc-skel-avatar"></div>
                <div class="svc-skel-lines">
                  <div class="svc-skel-bar svc-skel-title"></div>
                  <div class="svc-skel-bar svc-skel-sub"></div>
                </div>
              </div>
              <div class="svc-skel-divider"></div>
              <div class="svc-skel-bar svc-skel-label"></div>
              <div class="svc-skel-bar svc-skel-input"></div>
              <div class="svc-skel-bar svc-skel-label svc-skel-label-2"></div>
              <div class="svc-skel-box"></div>
            </div>
            <div class="svc-custom-submit-wrap">
              <button type="button" id="svc-custom-submit" class="svc-custom-submit-btn">Submit request</button>
              <p class="svc-custom-submit-note">Review your request details, then submit to the Service Desk.</p>
            </div>
          </div>
        </div>
        <aside class="svc-side-column" aria-label="Suggested help articles">
          <section class="svc-article-card">
            <div class="svc-article-card-header">
              <h2 class="svc-card-title svc-article-title">Suggested articles</h2>
              <p class="svc-article-subtitle">Related content appears as you type.</p>
            </div>
            <div id="svc-suggested-articles" class="svc-article-list" aria-live="polite">
              <div class="svc-article-empty">Start typing in the request form to see related knowledge base articles.</div>
            </div>
          </section>
        </aside>
      </div>

      {{!-- Helper information cards --}}
      <div class="svc-helper-row" aria-label="Helpful information">
        <section class="svc-card">
          <h2 class="svc-card-title">Helpful details to include</h2>
          <ul class="svc-card-list">
            <li>What you're trying to do or fix in plain language.</li>
            <li>Where this applies (system, URL, device, location, or team).</li>
            <li>Who is affected (you, your team, or a distribution list).</li>
            <li>Any timing or context that might change how we handle it.</li>
          </ul>
        </section>
        <section class="svc-card">
          <h2 class="svc-card-title">What happens after you submit?</h2>
          <ul class="svc-card-list">
            <li>You'll receive an email confirmation with your request or ticket number.</li>
            <li>You can reply to that email at any time to add updates or attachments.</li>
            <li>You can track progress in the Service Hub under <strong>My requests</strong>.</li>
          </ul>
        </section>
        <section class="svc-card">
          <h2 class="svc-card-title">Need help with the form?</h2>
          <ul class="svc-card-list">
            <li>If you're not sure which option fits, pick the closest one and explain in the description field.</li>
            <li>Use clear language instead of acronyms whenever possible.</li>
            <li>For urgent issues, keep using your usual escalation channel in addition to submitting this request.</li>
          </ul>
        </section>
      </div>

      {{!-- General-request footer banner --}}
      <div class="svc-help-banner">
        <div class="svc-help-banner-text">
          <span class="svc-help-banner-title">Still can&rsquo;t find what you need?</span>
          <span class="svc-help-banner-sub">Submit a general request.</span>
        </div>
        <a class="svc-help-btn" href="/hc/{{help_center.base_locale}}/services/01KT6W4J21065JGC51VMSW8AGB?category_id=01KP3TEETSJKEPJ08CSK7MJG41">
          General request
        </a>
      </div>

    </div>
  </div>
</div>

{{!-- Render the embedded service catalog item form --}}
<script type="module">
  import { renderServiceCatalogItem } from "service-catalog";
  const settings  = {{json settings}};
  const container = document.getElementById("service-catalog-item");
  const id = window.location.pathname.split("/").pop();
  const props = {
    baseLocale:            {{json help_center.base_locale}},
    hasAtMentions:         {{json help_center.at_mentions_enabled}},
    userRole:              {{json user.role}},
    userId:                {{json user.id}},
    brandId:               {{json brand.id}},
    organizations:         {{json user.organizations}},
    serviceCatalogItemId:  id,
    helpCenterPath:        {{json (page_path 'help_center')}},
  };
  renderServiceCatalogItem(container, settings, props);
</script>

{{!-- Compact search: services (catalog API) + articles (Help Center API) --}}
<script>
  (function () {
    var form    = document.getElementById('svc-mini-search');
    var input   = document.getElementById('svc-mini-input');
    var results = document.getElementById('svc-mini-results');
    if (!form || !input || !results) return;

    var HC_BASE      = (location.pathname.match(/^\/hc\/[^/]+/) || ['/hc/en-us'])[0];
    var SERVICES_URL = HC_BASE + '/services';
    var SEARCH_PAGE  = HC_BASE + '/search?query=';
    var MAX = 5;
    var timer = null, token = 0;

    var SYNONYMS = {
      laptop:   ['device', 'computer', 'macbook', 'hardware', 'equipment'],
      computer: ['device', 'laptop', 'hardware', 'equipment'],
      monitor:  ['device', 'peripheral', 'hardware', 'display'],
      keyboard: ['device', 'peripheral', 'hardware'],
      mouse:    ['device', 'peripheral', 'hardware'],
      wifi:     ['network', 'internet', 'wireless', 'connection'],
      internet: ['network', 'wifi', 'connection'],
      vpn:      ['network', 'remote', 'access', 'connection'],
      email:    ['outlook', 'mailbox', 'mail'],
      phone:    ['mobile', 'cell', 'device', 'telephone'],
      login:    ['account', 'password', 'access', 'sign in', 'credentials'],
      signin:   ['account', 'password', 'access', 'login'],
      printer:  ['print', 'peripheral', 'device']
    };

    if (results.parentElement !== document.body) document.body.appendChild(results);

    var ICON_SERVICE = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="2"></rect><line x1="2" y1="20" x2="22" y2="20"></line></svg>';
    var ICON_DOC     = '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>';

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }
    function stripTags(s) { var d = document.createElement('div'); d.innerHTML = s || ''; return (d.textContent || '').trim(); }

    function fetchJSON(url, tok) {
      return fetch(url, { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (d) { return tok === token ? d : null; })
        .catch(function () { return null; });
    }

    var allServices = null;
    var servicesLoading = null;

    /* Cache the fetched catalog in sessionStorage so it loads once per session
       (TTL 30 min) instead of on every page load. Shared with the home page. */
    var SVC_CACHE_KEY = 'svcCatalogItems';
    var SVC_CACHE_TTL = 30 * 60 * 1000;
    function svcReadCache() {
      try {
        var c = JSON.parse(sessionStorage.getItem(SVC_CACHE_KEY) || 'null');
        if (!c || !Array.isArray(c.items) || (Date.now() - c.ts) > SVC_CACHE_TTL) return null;
        return c.items;
      } catch (e) { return null; }
    }
    function svcWriteCache(items) {
      try { sessionStorage.setItem(SVC_CACHE_KEY, JSON.stringify({ ts: Date.now(), items: items })); } catch (e) {}
    }

    function normalizeItem(it) {
      var id = it.id || it.uuid || '';
      return {
        title: stripTags(it.name || it.title || 'Service'),
        desc:  stripTags(it.description || ''),
        category: stripTags(it.category_name || (it.category && it.category.name) || ''),
        href:  it.html_url || (id ? HC_BASE + '/services/' + id : SERVICES_URL)
      };
    }

    function loadAllServices() {
      if (allServices) return Promise.resolve(allServices);
      if (servicesLoading) return servicesLoading;
      var cached = svcReadCache();
      if (cached) { allServices = cached; return Promise.resolve(cached); }
      servicesLoading = (async function () {
        var out = [];
        var url = '/api/v2/help_center/service_catalog/items.json?page[size]=100';
        var guard = 0;
        while (url && guard < 20) {
          guard++;
          var data;
          try {
            var r = await fetch(url, { headers: { Accept: 'application/json' }, credentials: 'same-origin' });
            if (!r.ok) break;
            data = await r.json();
          } catch (e) { break; }
          var arr = data.service_catalog_items || data.items || data.results || data.records || [];
          arr.forEach(function (it) { out.push(normalizeItem(it)); });
          url = (data.meta && data.meta.has_more && data.links && data.links.next) ? data.links.next : null;
        }
        allServices = out;
        svcWriteCache(out);
        return out;
      })();
      return servicesLoading;
    }

    function scoreService(svc, terms) {
      var title = svc.title.toLowerCase();
      var desc  = svc.desc.toLowerCase();
      var cat   = svc.category.toLowerCase();
      var score = 0;
      for (var i = 0; i < terms.length; i++) {
        var t = terms[i];
        if (!t) continue;
        if (title === t) score += 100;
        else if (title.indexOf(t) === 0) score += 50;
        else if (title.indexOf(t) !== -1) score += 30;
        if (desc.indexOf(t) !== -1) score += 10;
        if (cat.indexOf(t) !== -1) score += 15;
      }
      return score;
    }

    function buildTerms(q) {
      var base = q.toLowerCase().split(/\s+/).filter(Boolean);
      var terms = {};
      base.forEach(function (w) { terms[w] = 1; });
      base.forEach(function (w) {
        var key = w.replace(/[^a-z]/g, '');
        (SYNONYMS[key] || []).forEach(function (s) { terms[s.toLowerCase()] = 1; });
      });
      return { primary: base, all: Object.keys(terms) };
    }

    function getServices(q) {
      return loadAllServices().then(function (list) {
        if (!list || !list.length) return [];
        var parts = buildTerms(q), primary = parts.primary, all = parts.all;
        var scored = list
          .map(function (svc) { return { svc: svc, score: scoreService(svc, primary) }; })
          .filter(function (x) { return x.score > 0; });
        if (scored.length < 3 && all.length > primary.length) {
          var have = {};
          scored.forEach(function (x) { have[x.svc.href] = 1; });
          list.forEach(function (svc) {
            if (have[svc.href]) return;
            var s = scoreService(svc, all);
            if (s > 0) scored.push({ svc: svc, score: s - 5 });
          });
        }
        scored.sort(function (a, b) { return b.score - a.score; });
        return scored.slice(0, MAX).map(function (x) {
          return {
            title: x.svc.title,
            href: x.svc.href,
            sub: x.svc.category || (x.svc.desc ? x.svc.desc.slice(0, 70) : 'Service catalog')
          };
        });
      });
    }

    function getDocs(q, tok) {
      var url = '/api/v2/help_center/articles/search.json?per_page=' + MAX + '&query=' + encodeURIComponent(q);
      return fetchJSON(url, tok).then(function (d) {
        if (!d) return [];
        return (d.results || []).slice(0, MAX).map(function (a) {
          return {
            title: stripTags(a.title) || 'Untitled',
            href: a.html_url || (SEARCH_PAGE + encodeURIComponent(q)),
            sub: a.snippet ? stripTags(a.snippet).slice(0, 70) : 'Knowledge article'
          };
        });
      });
    }

    function group(title, cls, badge, icon, items) {
      if (!items.length) return '';
      var itemCls = cls === 'svc-mr-services' ? 'svc-mr-service' : 'svc-mr-doc';
      var html = '<div class="svc-mr-group-header ' + cls + '">' +
        '<span class="svc-mr-group-title">' + esc(title) + '</span>' +
        '<span class="svc-mr-group-count">' + items.length + '</span></div>';
      items.forEach(function (it) {
        html += '<a class="svc-mr-item ' + itemCls + '" role="option" href="' + esc(it.href) + '">' +
          '<span class="svc-mr-icon" aria-hidden="true">' + icon + '</span>' +
          '<span class="svc-mr-text"><span class="svc-mr-title">' + esc(it.title) + '</span>' +
          '<span class="svc-mr-sub">' + esc(it.sub) + '</span></span>' +
          '<span class="svc-mr-badge">' + badge + '</span></a>';
      });
      return html;
    }

    function place() {
      var r = form.getBoundingClientRect();
      var m = 12;
      var w = Math.min(r.width, window.innerWidth - m * 2);
      var l = Math.min(Math.max(r.left, m), window.innerWidth - m - w);
      results.style.left  = Math.round(l) + 'px';
      results.style.width = Math.round(w) + 'px';
      results.style.top   = Math.round(r.bottom + 8) + 'px';
    }
    function show(html) { results.innerHTML = html; results.hidden = false; place(); input.setAttribute('aria-expanded', 'true'); }
    function hide()     { results.hidden = true; results.innerHTML = ''; input.setAttribute('aria-expanded', 'false'); }

    function run(q) {
      q = (q || '').trim();
      if (q.length < 2) { hide(); return; }
      var tok = ++token;
      show('<div class="svc-mr-loading">Searching…</div>');
      Promise.all([getServices(q), getDocs(q, tok)]).then(function (res) {
        var services = res[0], docs = res[1];
        if (tok !== token) return;
        var html =
          group('Recommended services', 'svc-mr-services', 'Service', ICON_SERVICE, services) +
          group('Self-Help Resources', 'svc-mr-docs', 'Resource', ICON_DOC, docs);
        if (!services.length && !docs.length) html = '<div class="svc-mr-empty">No matching services or resources.</div>';
        html += '<a class="svc-mr-footer" href="' + SEARCH_PAGE + encodeURIComponent(q) + '">See all results for &ldquo;' + esc(q) + '&rdquo;</a>';
        show(html);
      });
    }

    loadAllServices();

    input.addEventListener('input', function () { clearTimeout(timer); var q = input.value; timer = setTimeout(function () { run(q); }, 220); });
    input.addEventListener('focus', function () { if (input.value.trim().length >= 2 && results.innerHTML) { results.hidden = false; place(); } });
    form.addEventListener('submit', function (e) { e.preventDefault(); var q = input.value.trim(); if (q) window.location.href = SEARCH_PAGE + encodeURIComponent(q); });

    input.addEventListener('keydown', function (e) {
      if (results.hidden) return;
      var items = Array.prototype.slice.call(results.querySelectorAll('.svc-mr-item'));
      if (!items.length) return;
      var i = items.findIndex(function (el) { return el.classList.contains('svc-mr-active'); });
      if (e.key === 'ArrowDown')      { e.preventDefault(); i = (i + 1) % items.length; }
      else if (e.key === 'ArrowUp')   { e.preventDefault(); i = (i - 1 + items.length) % items.length; }
      else if (e.key === 'Enter' && i >= 0) { e.preventDefault(); window.location.href = items[i].getAttribute('href'); return; }
      else if (e.key === 'Escape')    { hide(); return; }
      else return;
      items.forEach(function (el) { el.classList.remove('svc-mr-active'); });
      items[i].classList.add('svc-mr-active');
      items[i].scrollIntoView({ block: 'nearest' });
    });

    document.addEventListener('click', function (e) { if (!form.contains(e.target) && !results.contains(e.target)) hide(); });
    window.addEventListener('scroll', function () { if (!results.hidden) place(); }, { passive: true });
    window.addEventListener('resize', function () { if (!results.hidden) place(); });
  })();
</script>

{{!-- Personalized greeting --}}
<script>
  (function () {
    var title = document.getElementById('svc-greeting');
    if (!title) return;

    function reveal() { title.classList.add('svc-greeting-ready'); }

    function looksLikeAlias(v) {
      if (!v) return true;
      var s = String(v).trim();
      if (!s) return true;
      if (s.indexOf('@') !== -1) return true;
      if (/^[a-z0-9._-]+$/.test(s) && s.indexOf(' ') === -1) return true;
      return false;
    }

    function firstNameOf(name) {
      var s = String(name || '').trim();
      if (!s) return '';
      if (s.indexOf(',') !== -1) {
        var parts = s.split(',').map(function (p) { return p.trim(); }).filter(Boolean);
        if (parts.length >= 2) return parts[1].split(/\s+/)[0];
      }
      return s.split(/\s+/)[0];
    }

    function setGreeting(name) {
      var first = firstNameOf(name);
      title.textContent = first ? ('How can we help, ' + first + '?') : 'How can we help?';
    }

    var revealed = false;
    var revealTimer = setTimeout(function () {
      if (revealed) return;
      revealed = true;
      setGreeting('');
      reveal();
    }, 2400);

    function finish(name) {
      if (revealed) return;
      revealed = true;
      clearTimeout(revealTimer);
      setGreeting(name || '');
      reveal();
    }

    fetch('/api/v2/users/me.json', { headers: { Accept: 'application/json' }, credentials: 'same-origin' })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        var u = d && d.user;
        if (!u) { finish(''); return; }
        var candidates = [
          u.name,
          u.details && u.details.name,
          u.user_fields && (u.user_fields.full_name || u.user_fields.preferred_name || u.user_fields.first_name)
        ];
        var realName = candidates.find(function (c) { return !looksLikeAlias(c); }) || u.name;
        finish(realName);
      })
      .catch(function () { finish(''); });
  })();
</script>

{{!-- Swap skeleton -> real form once complete --}}
<script>
  (function () {
    var root = document.documentElement;
    var form = document.getElementById('service-catalog-item');
    var skel = document.getElementById('svc-form-skeleton');
    if (!form) return;

    var done = false;
    function showForm() {
      if (done) return;
      done = true;
      root.classList.add('svc-form-ready');
      if (skel) {
        skel.classList.add('svc-skel-hide');
        setTimeout(function () { if (skel && skel.parentNode) skel.parentNode.removeChild(skel); }, 320);
      }
    }

    function formIsComplete() {
      return !!form.querySelector('input, textarea, select, button[type="submit"], [role="textbox"]');
    }

    var SETTLE_MS = 400;
    var settleTimer = null;
    function armSettle() {
      if (settleTimer) clearTimeout(settleTimer);
      settleTimer = setTimeout(showForm, SETTLE_MS);
    }

    function check() {
      if (done) return;
      if (formIsComplete()) armSettle();
    }

    check();
    var mo = new MutationObserver(check);
    mo.observe(form, { childList: true, subtree: true });
    (function stop() { if (done) mo.disconnect(); else setTimeout(stop, 300); })();

    setTimeout(showForm, 6000);

    window.addEventListener('pageshow', function (e) { if (e.persisted) showForm(); });
  })();
</script>

{{!-- Floating training button --}}
<script>
  (function () {
    var TRAINING_URL = 'REPLACE_WITH_TRAINING_URL';
    if (document.getElementById('svc-training-fab')) return;

    var fab = document.createElement('a');
    fab.id = 'svc-training-fab';
    fab.className = 'svc-training-fab';
    fab.href = TRAINING_URL;
    fab.setAttribute('aria-label', 'Looking for Technology Training?');
    fab.innerHTML =
      '<span class="svc-training-fab-icon" aria-hidden="true">' +
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
          '<path d="M22 10L12 5 2 10l10 5 10-5z"></path>' +
          '<path d="M6 12v5c0 1 2.5 2.5 6 2.5s6-1.5 6-2.5v-5"></path>' +
        '</svg>' +
      '</span>' +
      '<span class="svc-training-fab-label">Looking for Technology Training?</span>';
    document.body.appendChild(fab);

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    setTimeout(function () {
      fab.classList.add('svc-fab-pulse');
      fab.addEventListener('animationend', function () { fab.classList.remove('svc-fab-pulse'); }, { once: true });
    }, 1200);
  })();
</script>

{{!-- Custom submit: hide the native action area and proxy the click --}}
<script>
  (function () {
    var serviceContainer = document.getElementById('service-catalog-item');
    var customSubmit = document.getElementById('svc-custom-submit');

    function getNativeSubmit() {
      if (!serviceContainer) return null;
      return serviceContainer.querySelector('button[type="submit"], input[type="submit"], [role="button"]');
    }

    function hideNativeActionArea() {
      if (!serviceContainer) return;
      var submitEl = getNativeSubmit();
      if (!submitEl) return;
      var actionBlock = submitEl.closest('section') || submitEl.closest('fieldset') || submitEl.closest('div[role="group"]') || submitEl.parentElement;
      while (actionBlock && actionBlock !== serviceContainer) {
        var txt = (actionBlock.textContent || '').replace(/\s+/g, ' ').trim();
        if (/submit request/i.test(txt) && /user/i.test(txt)) {
          actionBlock.classList.add('svc-hide-native-actions');
          return;
        }
        actionBlock = actionBlock.parentElement;
      }
    }

    function wireCustomSubmit() {
      if (!customSubmit) return;
      customSubmit.addEventListener('click', function () {
        var nativeSubmit = getNativeSubmit();
        if (!nativeSubmit) return;
        customSubmit.disabled = true;
        customSubmit.textContent = 'Submitting...';
        nativeSubmit.click();
        setTimeout(function () {
          customSubmit.disabled = false;
          customSubmit.textContent = 'Submit request';
        }, 3000);
      });
    }

    window.addEventListener('load', function () {
      wireCustomSubmit();
      hideNativeActionArea();
      if (serviceContainer) {
        var obs = new MutationObserver(function () { hideNativeActionArea(); });
        obs.observe(serviceContainer, { childList: true, subtree: true });
      }
    });
  })();
</script>

{{!-- Suggested articles: live search based on form input --}}
<script>
  (function () {
    var serviceContainer = document.getElementById('service-catalog-item');
    var suggestionsEl = document.getElementById('svc-suggested-articles');
    var locale = {{json help_center.locale}};
    var brandId = {{json brand.id}};
    if (!serviceContainer || !suggestionsEl) return;

    var lastQuery = '';
    var activeController = null;

    function escapeHtml(str) {
      return String(str || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function stripHtml(str) {
      var div = document.createElement('div');
      div.innerHTML = str || '';
      return (div.textContent || div.innerText || '').trim();
    }
    function truncate(str, max) {
      var text = String(str || '').trim();
      return text.length <= max ? text : text.slice(0, max).trim() + '…';
    }

    function renderEmpty(message) {
      suggestionsEl.innerHTML = '<div class="svc-article-empty">' + escapeHtml(message) + '</div>';
    }
    function renderLoading() {
      suggestionsEl.innerHTML = '<div class="svc-article-loading">Searching for related articles...</div>';
    }
    function renderError() {
      suggestionsEl.innerHTML = '<div class="svc-article-error">We couldn\'t load suggested articles right now.</div>';
    }
    function renderArticles(results) {
      if (!results || !results.length) {
        renderEmpty('No related articles found yet. Try adding more detail in the request description.');
        return;
      }
      suggestionsEl.innerHTML = results.map(function (article) {
        var t = escapeHtml(article.title || 'Untitled article');
        var href = escapeHtml(article.html_url || article.url || '#');
        var body = truncate(stripHtml(article.snippet || article.body || article.description || ''), 140) || 'Open this article for more details.';
        var section = article.section_name ? 'Section: ' + escapeHtml(article.section_name) : '';
        return '<a class="svc-article-item" href="' + href + '">' +
          '<span class="svc-article-item-title">' + t + '</span>' +
          '<span class="svc-article-item-meta">' + escapeHtml(body) + '</span>' +
          (section ? '<span class="svc-article-item-meta">' + section + '</span>' : '') +
          '</a>';
      }).join('');
    }

    function getFormText() {
      var fields = serviceContainer.querySelectorAll('input[type="text"], input:not([type]), textarea, select');
      var values = [];
      fields.forEach(function (field) {
        if (field.disabled) return;
        if (field.tagName === 'SELECT') {
          var selected = field.options[field.selectedIndex];
          if (selected && selected.value) values.push((selected.textContent || '').trim());
          return;
        }
        var value = (field.value || '').trim();
        if (value) values.push(value);
      });
      return values.join(' ').replace(/\s+/g, ' ').trim();
    }
    function normalizeQuery(text) {
      return text.toLowerCase().replace(/[^\w\s-]/g, ' ').replace(/\s+/g, ' ').trim();
    }

    function searchArticles(query) {
      if (activeController) activeController.abort();
      activeController = new AbortController();
      var url = new URL('/api/v2/help_center/articles/search.json', window.location.origin);
      url.searchParams.set('query', query);
      url.searchParams.set('per_page', '5');
      if (locale) url.searchParams.set('locale', locale);
      if (brandId) url.searchParams.set('brand_id', String(brandId));
      return fetch(url.toString(), { method: 'GET', headers: { Accept: 'application/json' }, signal: activeController.signal })
        .then(function (response) {
          if (!response.ok) throw new Error('Article search failed with status ' + response.status);
          return response.json();
        })
        .then(function (data) { return data.results || []; });
    }

    function updateSuggestions() {
      var query = normalizeQuery(getFormText());
      if (query.length < 3) {
        lastQuery = '';
        if (activeController) activeController.abort();
        renderEmpty('Start typing in the request form to see related knowledge base articles.');
        return;
      }
      if (query === lastQuery) return;
      lastQuery = query;
      renderLoading();
      searchArticles(query).then(renderArticles).catch(function (error) {
        if (error.name === 'AbortError') return;
        renderError();
      });
    }

    var debouncedUpdate = (function () {
      var timer;
      return function () {
        clearTimeout(timer);
        timer = setTimeout(updateSuggestions, 350);
      };
    })();

    serviceContainer.addEventListener('input', debouncedUpdate);
    serviceContainer.addEventListener('change', debouncedUpdate);
    new MutationObserver(debouncedUpdate).observe(serviceContainer, { childList: true, subtree: true });
    updateSuggestions();
  })();
</script>

{{!-- Redirect the "Services" breadcrumb to the help center home --}}
<script>
  (function () {
    var HOME_URL = (location.pathname.match(/^\/hc\/[^/]+/) || ['/hc/en-us'])[0];

    function rewireServicesCrumb() {
      var subnav = document.querySelector('.svc-subnav');
      if (!subnav) return;
      subnav.querySelectorAll('a').forEach(function (a) {
        if (a.dataset.svcRewired === '1') return;
        var label = (a.textContent || '').replace(/\s+/g, ' ').trim();
        if (label.toLowerCase() === 'services') {
          a.setAttribute('href', HOME_URL);
          a.dataset.svcRewired = '1';
          a.addEventListener('click', function (e) {
            e.preventDefault();
            window.location.href = HOME_URL;
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', rewireServicesCrumb);
    } else {
      rewireServicesCrumb();
    }

    var subnav = document.querySelector('.svc-subnav');
    if (subnav) new MutationObserver(rewireServicesCrumb).observe(subnav, { childList: true, subtree: true });
  })();
</script>
