<style>
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

/* ---------- BRAND TOKENS ---------- */
:root {
  --svc-navy:        #003399;
  --svc-navy-deep:   #002a6e;
  --svc-navy-hero:   #0a1747;
  --svc-pink:        #e6007e;
  --svc-pink-deep:   #c4006a;
  --svc-ink:         #1d2b4d;
  --svc-gray:        #5b6472;
  --svc-gray-soft:   #8089a0;
  --svc-line:        #eef1f6;
  --svc-tint:        #eaf0ff;
  --svc-tint-hover:  #f1f5ff;
  --svc-font: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* ---------- HOME-PAGE HEADER (transparent over the hero) ---------- */
.svc-home .header {
  background: transparent !important;
  border-bottom: none !important;
  box-shadow: none !important;
  position: relative;
  z-index: 5;
}
.svc-home .header .search-wrapper,
.svc-home .header .search,
.svc-home .header form[role="search"],
.svc-home .header .search-full { display: none !important; }
.svc-home .header .logo span,
.svc-home .header .ask-ai span,
.svc-home .header .user-nav a,
.svc-home .header .sign-in {
  color: #ffffff !important;
}
.svc-home .header .user-info span,
.svc-home .header .dropdown-toggle span,
.svc-home .header .dropdown-chevron-icon {
  color: var(--svc-navy) !important;
}
.svc-home .header .ask-ai {
  background: rgba(255, 255, 255, 0.12) !important;
  border-radius: 999px;
  padding: 7px 14px;
}
.svc-home .header .ask-ai-icon,
.svc-home .header .icon-menu { color: #ffffff !important; }
.svc-home .header .menu-button-mobile { color: #ffffff !important; }

/* ---------- HERO ---------- */
.svc-hero { position: relative; }
.svc-hero .svc-hero-inner,
.svc-hero .hero-inner {
  display: flex !important;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100% !important;
  max-width: 100% !important;
  min-height: 240px;
  padding: 36px clamp(20px, 6vw, 88px);
  box-sizing: border-box;
}
.svc-hero-greeting {
  width: 100%;
  max-width: 1000px;
  color: #fff;
  font-family: var(--svc-font);
  position: relative;
  z-index: 2;
  text-align: center;
}
.svc-hero-title {
  margin: 0;
  font-size: clamp(28px, 4vw, 44px);
  line-height: 1.08;
  font-weight: 700;
  letter-spacing: -0.5px;
