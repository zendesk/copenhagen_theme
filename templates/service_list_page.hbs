/* ============================================================
   ARPA-H custom — service list page section
   (extracted from service_list_page.hbs)
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

body {
  background: #ffffff;
}

/* Apply Poppins across the template */
.svc-list-container,
.svc-list-container *,
.service-catalog-main-content,
.service-catalog-main-content *,
.svc-tooltip {
  font-family: 'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
}

/* Remove bold from service titles / card text */
.service-catalog-main-content a[href*="/services/"],
.service-catalog-main-content a[href*="/services/"] *,
.service-catalog-main-content [class*="card"] *,
.service-catalog-main-content [class*="Card"] * {
  font-weight: 400 !important;
}

.container-divider {
  border-top: none;
  height: 16px;
  background: transparent;
}

.svc-list-container {
  max-width: 1280px;
}

.svc-list-subnav {
  margin-bottom: 10px;
}

.svc-list-shell {
  background: #ffffff;
  border-radius: 20px;
  box-shadow:
    0 14px 36px rgba(15, 33, 80, 0.08),
    0 0 0 1px rgba(16, 30, 67, 0.05);
  padding: 20px 22px 28px;
  margin-bottom: 36px;
}

/* Top bar — matches the item page header */
.svc-list-topbar {
  background: linear-gradient(145deg, #002a6e, #004a9f);
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 22px;
  color: #ffffff;
  box-shadow: 0 10px 24px rgba(0, 35, 102, 0.22);
}
.svc-list-topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}
.svc-list-topbar-left {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}
.svc-list-topbar-logo {
  height: 48px;
  width: 48px;
  min-width: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  border-radius: 12px;
  overflow: hidden;
  background: transparent;
}
.svc-list-topbar-logo img,
.svc-list-topbar-logo svg {
  width: 48px;
  height: 48px;
  object-fit: contain;
  display: block;
}
.svc-list-topbar-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}
.svc-list-title {
  margin: 0;
  font-size: clamp(20px, 2.2vw, 26px);
  line-height: 1.15;
  font-weight: 700;
  color: #ffffff;
}
.svc-list-subtitle {
  margin: 4px 0 0;
  font-size: 13px;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.82);
}

/* ============================================
   ICON BACKGROUND FIX
   Removes the gray box behind service icons
   ============================================ */
.service-catalog-main-content figure,
.service-catalog-main-content [data-garden-id="avatars.avatar"],
.service-catalog-main-content [class*="StyledAvatar"],
.service-catalog-main-content [class*="Avatar"],
.service-catalog-main-content [class*="imWYAI"],
.service-catalog-main-content [class*="hkLxcw"],
.service-catalog-main-content [class*="icon"],
.service-catalog-main-content [class*="Icon"] {
  background: transparent !important;
  background-color: transparent !important;
  box-shadow: none !important;
  border: none !important;
}

/* Service cards — clean white with soft shadow on hover */
.service-catalog-main-content [class*="card"],
.service-catalog-main-content [class*="Card"],
.service-catalog-main-content a[href*="/services/"] {
  border-radius: 14px !important;
  background: #ffffff !important;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease !important;
}
.service-catalog-main-content a[href*="/services/"]:hover,
.service-catalog-main-content [class*="card"]:hover,
.service-catalog-main-content [class*="Card"]:hover {
  border-color: rgba(230, 0, 126, 0.35) !important;
  box-shadow: 0 0 0 1px rgba(230, 0, 126, 0.18), 0 8px 18px rgba(230, 0, 126, 0.10) !important;
  transform: translateY(-1px) !important;
}

/* ============================================
   SLEEK CATEGORY SIDEBAR
   Anchored to the stable data-test-id.
   ============================================ */
.service-catalog-main-content [data-test-id^="sidebar-category"] {
  position: relative !important;
  border-radius: 10px !important;
  padding: 9px 12px !important;
  margin-bottom: 2px !important;
  cursor: pointer !important;
  transition: background-color 0.18s ease, color 0.18s ease !important;
  overflow: hidden !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"]::before {
  content: "" !important;
  position: absolute !important;
  left: 0 !important;
  top: 50% !important;
  transform: translateY(-50%) scaleY(0) !important;
  height: 58% !important;
  width: 3px !important;
  border-radius: 0 3px 3px 0 !important;
  background: #003399 !important;
  transition: transform 0.18s ease !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"]:hover {
  background: #f1f5ff !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"]:hover::before {
  transform: translateY(-50%) scaleY(1) !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-pressed="true"],
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-current="true"],
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active {
  background: #eaf0ff !important;
  color: #003399 !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-pressed="true"]::before,
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-current="true"]::before,
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active::before {
  transform: translateY(-50%) scaleY(1) !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-pressed="true"] span:first-child,
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-current="true"] span:first-child,
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active span:first-child {
  font-weight: 500 !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"] span:last-child {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 22px !important;
  height: 22px !important;
  padding: 0 7px !important;
  border-radius: 999px !important;
  background: #eef1f6 !important;
  color: #5b6472 !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  transition: background-color 0.18s ease, color 0.18s ease !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-pressed="true"] span:last-child,
.service-catalog-main-content [data-test-id^="sidebar-category"][aria-current="true"] span:last-child,
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active span:last-child {
  background: #003399 !important;
  color: #ffffff !important;
}

/* Search input polish */
.service-catalog-main-content input[type="text"],
.service-catalog-main-content input[type="search"],
.service-catalog-main-content input:not([type]) {
  border-radius: 12px !important;
}

/* ============================================
   HIDDEN DESCRIPTIONS + SLEEK HOVER TOOLTIP
   ============================================ */
.service-catalog-main-content .svc-desc-hidden {
  display: none !important;
}
.service-catalog-main-content a[href*="/services/"] p,
.service-catalog-main-content [class*="card"] p,
.service-catalog-main-content [class*="Card"] p {
  display: none !important;
}
.svc-tooltip {
  position: fixed;
  z-index: 10000;
  max-width: 240px;
  background: #1d2b4d;
  color: #ffffff;
  padding: 8px 11px;
  border-radius: 8px;
  font-size: 12px;
  line-height: 1.4;
  box-shadow: 0 6px 18px rgba(0, 25, 80, 0.20);
  pointer-events: none;
  opacity: 0;
  transform: translateY(4px);
  transition: opacity 0.16s ease, transform 0.16s ease;
  will-change: opacity, transform;
}
.svc-tooltip.svc-tooltip-visible {
  opacity: 1;
  transform: translateY(0);
}
.svc-tooltip::after {
  content: "";
  position: absolute;
  left: var(--svc-arrow-left, 20px);
  width: 8px;
  height: 8px;
  background: #1d2b4d;
  transform: rotate(45deg);
}
.svc-tooltip.svc-tooltip-below::after {
  top: -4px;
}
.svc-tooltip.svc-tooltip-above::after {
  bottom: -4px;
}
@media (prefers-reduced-motion: reduce) {
  .svc-tooltip {
    transition: none !important;
    transform: none !important;
  }
}

/* ============================================
   "CAN'T FIND IT" HELP PROMPT
   ============================================ */
/* Row wrapper (was inline styles in buildPrompt() JS — now contained here) */
.svc-help-prompt-row {
  display: flex;
  justify-content: flex-end;
  width: 100%;
}
a.svc-help-prompt,
.service-catalog-main-content a.svc-help-prompt {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  width: auto;
  margin: 0 0 16px;
  padding: 8px 14px;
  border-radius: 999px;
  background: linear-gradient(145deg, #c4006a, #e6007e) !important;
  border: none !important;
  text-decoration: none !important;
  box-shadow: 0 4px 10px rgba(230, 0, 126, 0.22);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
  white-space: nowrap;
}
a.svc-help-prompt:hover,
.service-catalog-main-content a.svc-help-prompt:hover {
  transform: translateY(-1px) !important;
  box-shadow: 0 8px 16px rgba(230, 0, 126, 0.30) !important;
  border-color: transparent !important;
}
.svc-help-prompt-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff !important;
}
.svc-help-prompt-icon svg {
  width: 15px;
  height: 15px;
  stroke: #ffffff !important;
}
.svc-help-prompt-text,
.svc-help-prompt-text strong,
a.svc-help-prompt .svc-help-prompt-text,
a.svc-help-prompt .svc-help-prompt-text strong {
  font-size: 13px;
  line-height: 1;
  color: #ffffff !important;
  font-weight: 500 !important;
}
.svc-help-prompt-arrow {
  display: inline-flex;
  align-items: center;
  color: #ffffff !important;
}
.svc-help-prompt-arrow svg {
  width: 14px;
  height: 14px;
  stroke: #ffffff !important;
}
@media (max-width: 600px) {
  .svc-help-prompt-cta {
    margin-left: 0;
    width: 100%;
    justify-content: center;
  }
}

/* ============================================
   CATEGORY DESCRIPTION (under the big heading)
   ============================================ */
.svc-cat-description {
  margin: 6px 0 0;
  font-size: 13.5px;
  line-height: 1.5;
  color: #5b6472;
  max-width: 640px;
}

/* Page load fade-in */
#main-content {
  opacity: 0;
  transform: translateY(8px);
  will-change: opacity, transform;
}
.svc-list-loaded #main-content {
  opacity: 1;
  transform: none;
  transition: opacity 0.32s ease, transform 0.32s ease;
}

/* Page exit transition */
#svc-list-exit-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #ffffff;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.26s ease;
}
.svc-list-exiting #svc-list-exit-overlay {
  opacity: 1;
}
.svc-list-exiting #main-content,
.svc-list-exiting .container,
.svc-list-exiting .container-divider {
  transition: transform 0.26s ease, filter 0.26s ease, opacity 0.26s ease;
  transform: scale(0.985);
  filter: saturate(0.98);
  opacity: 0.96;
}

/* Hide editor/debug leftovers */
body > pre,
body > code,
body > .template-name,
body > .editor-label {
  display: none !important;
}

@media (max-width: 960px) {
  .svc-list-shell {
    padding: 16px 12px 22px;
  }
  .svc-list-topbar-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
@media (prefers-reduced-motion: reduce) {
  #main-content {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
  #svc-list-exit-overlay,
  .container,
  .container-divider {
    transition: none !important;
  }
}

/* ============================================================
   ⚠️ SECOND SIDEBAR BLOCK — was pasted (broken) inside a <script>
   tag at the bottom of the .hbs. Moved here so it's valid CSS.
   NOTE: this DUPLICATES/OVERRIDES the "SLEEK CATEGORY SIDEBAR"
   block above and relies on CSS variables that are NOT defined
   in this file (--svc-ink, --svc-navy, --svc-tint,
   --svc-tint-hover, --svc-line, --svc-gray). See notes below.
   ============================================================ */
.service-catalog-main-content [data-test-id^="sidebar-category"] {
  position: relative !important;
  border-radius: 10px !important;
  padding: 9px 12px !important;
  margin-bottom: 2px !important;
  cursor: pointer !important;
  overflow: hidden !important;
  color: var(--svc-ink) !important;
  background: transparent !important;
  transition: background-color 0.18s ease !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"],
.service-catalog-main-content [data-test-id^="sidebar-category"] *,
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active,
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active * {
  border-radius: 10px !important;
  background-clip: padding-box !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"] span:last-child {
  border-radius: 999px !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"] > * {
  background: transparent !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"] span:first-child {
  font-weight: 400 !important;
  color: var(--svc-ink) !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"]:not(.svc-cat-active):hover {
  background: var(--svc-tint-hover) !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active {
  background: var(--svc-tint) !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active > * {
  background: transparent !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active span:first-child {
  color: var(--svc-navy) !important;
  font-weight: 500 !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active::before {
  content: "" !important;
  position: absolute !important;
  left: 0 !important; top: 50% !important;
  width: 3px !important; height: 58% !important;
  border-radius: 0 3px 3px 0 !important;
  background: var(--svc-navy) !important;
  transform: translateY(-50%) !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"] span:last-child {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-width: 22px !important; height: 22px !important;
  padding: 0 7px !important;
  background: var(--svc-line) !important;
  color: var(--svc-gray) !important;
  font-size: 12px !important;
  font-weight: 500 !important;
}
.service-catalog-main-content [data-test-id^="sidebar-category"].svc-cat-active span:last-child {
  background: var(--svc-navy) !important;
  color: #fff !important;
}
