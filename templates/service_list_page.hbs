            <div class="svc-cat-skel-row"></div>
            <div class="svc-cat-skel-row"></div>
            <div class="svc-cat-skel-row"></div>
            <div class="svc-cat-skel-row"></div>
            <div class="svc-cat-skel-row"></div>
            <div class="svc-cat-skel-row"></div>
          </div>
          <div class="svc-cat-skel-main">
