    const main = document.getElementById("service-catalog-main-content");
    if (main) {
      main.innerHTML =
        '<p class="svc-catalog-fallback">View the full ' +
        '<a href="https://arpah1775164538.zendesk.com/hc/en-us/services">Service Catalog</a>.</p>';
