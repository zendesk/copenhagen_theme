<!-- ============================================================
     HOME PAGE (service_list_page) — unified hero + combined live search + catalog
     Customized 6-15-26
     Updated: mobile header cleanup (hide duplicate menu button)
     Updated 7-09-26: fix single-service card text cutoff on mobile.
     Updated 7-09-26: reverted the sidebar to Zendesk's fully native look.
     Updated 7-10-26: fixed mobile category-toggle bug (dimmer category +
                      page jump + search bar move).
     Updated 7-10-26: (a) service icons never clip; (b) removed return-to-home
                      flicker; (c) general debug pass.
     Updated 7-10-26: FLICKER FIX — eliminate flash-of-unstyled-content.
     Updated 7-13-26: HEADER NAME CONSISTENCY — header shows real display name.
     Updated 7-15-26: FOUC FIX v2 — the "giant magnifier / scattered text"
                      flash on navigating to Knowledge is fixed three ways:
                      (1) all four hero SVGs now carry intrinsic width/height
                          so an unstyled paint can never balloon them to full
                          viewport size (this was the giant magnifier);
                      (2) the FOUC guard is INVERTED — hero + catalog are
                          hidden by default and only revealed once <html> is
                          tagged .svc-ready, which happens after the catalog is
                          genuinely staged (not synchronously);
                      (3) a hard failsafe + bfcache reveal guarantee the page
                          can never get stuck hidden.
     ============================================================ -->

<!-- CRITICAL FOUC GUARD — kept first so it parses as early as possible.
     Hidden by default; revealed only when <html> gets .svc-ready. -->
<style id="svc-fouc-critical">
  .svc-hero,
  .svc-cardwrap { visibility: hidden; }
  html.svc-ready .svc-hero,
  html.svc-ready .svc-cardwrap { visibility: visible; }
  /* Failsafe: never stay hidden longer than 6.5s even if JS never runs. */
  @keyframes svcRevealFailsafe { to { visibility: visible; } }
  .svc-hero,
  .svc-cardwrap { animation: svcRevealFailsafe 0s linear 6.5s forwards; }
</style>

<h1 class="visibility-hidden">{{ help_center.name }}</h1>
<script>
  /* Tag the page as the home page so the global header can restyle itself
     ONLY here (Zendesk adds no built-in home-page class). Runs synchronously.
     NOTE: this no longer controls hero visibility — that is now handled by
     the .svc-ready class set after the catalog stages. */
  (function () {
    var add = function () {
      document.documentElement.classList.add('svc-home');
      if (document.body) document.body.classList.add('svc-home');
    };
    add();
    document.addEventListener('DOMContentLoaded', add);
  })();
</script>

<!-- ===== HERO (greeting + search) ===== -->
<section id="hero-content" class="section hero svc-hero">
  <div class="hero-inner svc-hero-inner">
    {{#if signed_in}}
    <div class="svc-hero-greeting">
      <h2 class="svc-hero-title"><span id="svc-list-greeting">&nbsp;</span><span id="svc-list-greeting-name" class="svc-greeting-name"></span></h2>
      <p class="svc-hero-subtitle" id="svc-list-subtitle">What do you need help with today?</p>

      <form class="svc-hero-search" id="svc-hero-search" role="search" autocomplete="off">
        <i class="svc-hero-search-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </i>
        <input type="text" id="svc-hero-input" class="svc-hero-input"
               placeholder="How can we help?" aria-label="Search"
               role="combobox" aria-expanded="false" aria-controls="svc-hero-results" aria-autocomplete="list" />
        <button type="submit" class="svc-hero-search-btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <div class="svc-hero-results" id="svc-hero-results" role="listbox" aria-label="Search results" hidden></div>
      </form>

      <div class="svc-hero-chips" id="svc-hero-chips">
        <span class="svc-hero-chips-label">Popular:</span>
        <button type="button" class="svc-hero-chip" data-q="PIV certificate renewal">PIV Cert Renewal</button>
        <button type="button" class="svc-hero-chip" data-q="lost stolen device">Lost/Stolen Device</button>
        <button type="button" class="svc-hero-chip" data-q="lost stolen PIV card">Lost/Stolen PIV Card</button>
        <button type="button" class="svc-hero-chip" data-q="external sharepoint">SharePoint</button>
        <button type="button" class="svc-hero-chip" data-q="shared mailbox distribution list">Shared Mailboxes/Distribution Lists</button>
      </div>
    </div>
    {{/if}}
  </div>
</section>

<script>
  /* Time-based greeting set synchronously, before first paint. */
  (function () {
    var el = document.getElementById('svc-list-greeting');
    if (!el) return;
    var h = new Date().getHours();
    el.textContent = h < 12 ? 'Good morning' : h < 17 ? 'Good afternoon' : 'Good evening';
  })();
</script>

