/* Hero chips */
.svc-hero-chips { display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
.svc-hero-chips-label { font-family: var(--svc-font); font-size: 12.5px; color: rgba(255, 255, 255, 0.6); }
.svc-hero-chip {
