              <div class="svc-cat-skel-card"></div>
              <div class="svc-cat-skel-card"></div>
              <div class="svc-cat-skel-card"></div>
              <div class="svc-cat-skel-card"></div>
              <div class="svc-cat-skel-card"></div>
