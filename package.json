    "@zendeskgarden/react-breadcrumbs": "9.15.5",
    "@zendeskgarden/react-buttons": "9.15.5",
    "@zendeskgarden/react-datepickers": "9.15.5",
    "@zendeskgarden/react-dropdowns": "9.15.5",
    "@zendeskgarden/react-forms": "9.15.5",
    "@zendeskgarden/react-grid": "9.15.5",
    "@zendeskgarden/react-loaders": "9.15.5",
    "@zendeskgarden/react-modals": "9.15.5",
    "@zendeskgarden/react-notifications": "9.15.5",
    "@zendeskgarden/react-pagination": "9.15.5",
    "@zendeskgarden/react-tables": "9.15.5",
    "@zendeskgarden/react-tabs": "9.15.5",
    "@zendeskgarden/react-tags": "9.15.5",
    "@zendeskgarden/react-theming": "9.15.5",
    "@zendeskgarden/react-tooltips": "9.15.5",
    "@zendeskgarden/react-typography": "9.15.5",
    "@zendeskgarden/svg-icons": "8.4.0",
    "dompurify": "3.4.8",
    "eslint-plugin-check-file": "^2.8.0",
    "i18next": "^23.16.8",
    "linkify-string": "^4.3.3",
    "linkifyjs": "^4.3.3",
    "lodash.debounce": "^4.0.8",
