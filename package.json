    "lighthouse": "12.8.2",
    "prettier": "2.8.8",
    "puppeteer": "24.43.1",
    "rollup": "3.30.0",
    "rollup-jest": "^3.1.0",
    "rollup-plugin-sass": "1.15.3",
    "sass": "1.100.0",
    "semantic-release": "19.0.5",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "url-pattern": "1.0.3",
    "vinyl": "^3.0.1",
    "vinyl-fs": "^4.0.2",
    "wait-on": "8.0.5"
