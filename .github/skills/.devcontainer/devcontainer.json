{
  "name": "ARPA-H Skills",
  // Universal image — no specific language stack detected; provides Node, Python, Go, etc.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    // gh CLI — required for all ARPA-H repos
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // bun — preferred package manager for all ARPA-H repos; version: none avoids overriding the universal image's Node.js
    "ghcr.io/devcontainers/features/node:1": {
      "version": "none",
      "installJupyterlab": false,
      "bunVersion": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        // ARPA-H standard: GitHub & collaboration
        "github.copilot-chat",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "github.github-vscode-theme",
        "dracula-theme.theme-dracula",
        // Markdown linting — *.md files present in repo
        "davidanson.vscode-markdownlint",
        // Prettier — formats JSON, CSS, YAML on save
        "esbenp.prettier-vscode",
        // Figma design integration
        "figma.figma-vscode-extension"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "git.autofetch": true,
        "git.autofetchPeriod": 180
      }
    }
  },
  // Remove stale LFS hooks; wire versioned hooks via core.hooksPath (uses bunx per ARPA-H toolchain standard)
  "postCreateCommand": "(grep -qr 'filter=lfs' .gitattributes 2>/dev/null || rm -f .git/hooks/pre-push .git/hooks/post-commit .git/hooks/post-checkout .git/hooks/post-merge) && git config core.hooksPath .devcontainer/hooks && chmod +x .devcontainer/hooks/*"
}
